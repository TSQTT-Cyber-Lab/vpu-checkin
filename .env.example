# VPU Điểm Danh Environment Configuration
# Copy this file to .env and update values for your environment
#
# Only these are actually read by the app (server/index.js, server/db.js, server/auth.js):
# PORT, AUTH_SECRET, DATABASE_URL, GOOGLE_CLIENT_ID, BOOTSTRAP_ADMIN_EMAIL. Everything
# else below is a template for future features, not something already wired up.

# ============================================
# Application Configuration
# ============================================

# Application port
PORT=3000

# Node environment (production, development, test)
NODE_ENV=production

# Base URL for QR codes (update this to your deployment URL)
# Default is https://claude.ai/artifact/YOUR_ARTIFACT_ID (for claude.ai artifact)
# For self-hosted: https://your-domain.com or http://localhost:3000
BASE_URL=http://localhost:3000

# ============================================
# Authentication & Security
# ============================================

# Secret key for authentication (generate a random string, minimum 32 characters)
# Linux: openssl rand -base64 32
# macOS: openssl rand -base64 32
# Windows PowerShell: [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
AUTH_SECRET=your-secret-key-generate-a-secure-random-string-here

# This address is always granted admin, independent of the roles document
# (server/roles.js) — the self-hosted equivalent of "the artifact owner".
BOOTSTRAP_ADMIN_EMAIL=you@your-domain.com

# ============================================
# Database Configuration
# ============================================

# Database type: sqlite, postgres, or memory (in-memory for demo)
DB_TYPE=postgres

# For PostgreSQL:
# Connection string format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://vpu_admin:change_me_in_production@db:5432/vpu_checkin

# PostgreSQL connection details (for docker-compose)
DB_NAME=vpu_checkin
DB_USER=vpu_admin
DB_PASSWORD=change_me_in_production
DB_HOST=db
DB_PORT=5432

# For SQLite (if using file-based database):
# DATABASE_URL=file:./data/db.sqlite

# ============================================
# Google OAuth & Google Drive Integration
# ============================================

# Required for sign-in. Set up at https://console.cloud.google.com/ — create an OAuth
# 2.0 "Web application" client and add this site to "Authorized JavaScript origins".
# No redirect URI needed: the app uses the ID-token flow (Google Identity Services).
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Not read by the server. Only needed for a redirect-based OAuth flow or Drive API
# access, neither of which is implemented — Drive export is disabled in self-hosted
# mode (use the CSV download instead). Safe to leave blank.
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Google Drive folder ID for storing exports (optional)
# Leave empty to use user's root drive
GOOGLE_DRIVE_FOLDER_ID=

# ============================================
# Email Configuration (Optional)
# ============================================

# SMTP server for sending notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@vpu-checkin.example.com

# Email addresses for notifications
ADMIN_EMAIL=admin@tbd.edu.vn
SUPPORT_EMAIL=support@tbd.edu.vn

# ============================================
# Logging & Monitoring
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable file logging
LOG_TO_FILE=true

# Log directory
LOG_DIR=./logs

# ============================================
# pgAdmin Configuration (for debugging)
# ============================================

# pgAdmin email and password (for database management interface)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5050

# ============================================
# Features & Flags
# ============================================

# Enable demo mode (uses in-memory database with sample data)
DEMO_MODE=false

# Enable API documentation (Swagger)
ENABLE_API_DOCS=true

# Max file upload size (in MB)
MAX_UPLOAD_SIZE=10

# ============================================
# Performance & Caching
# ============================================

# Redis URL for caching (optional)
# Format: redis://username:password@host:port
REDIS_URL=

# Cache TTL in seconds (0 = no cache)
CACHE_TTL=300

# ============================================
# Rate Limiting
# ============================================

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Max requests per IP per minute
RATE_LIMIT_MAX=100

# ============================================
# CORS & Security
# ============================================

# Allowed origins (comma-separated)
# For local development: http://localhost:3000,http://localhost:5173
# For production: https://your-domain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Enable HTTPS only (recommended for production)
HTTPS_ONLY=false

# ============================================
# Deployment Notes
# ============================================

# Docker Compose: db service name is 'db'
#   DATABASE_URL=postgresql://vpu_admin:password@db:5432/vpu_checkin

# Local Development: use localhost
#   DATABASE_URL=postgresql://vpu_admin:password@localhost:5432/vpu_checkin

# Self-hosted (manual): update host/port accordingly
#   DATABASE_URL=postgresql://vpu_admin:password@your-server.com:5432/vpu_checkin
